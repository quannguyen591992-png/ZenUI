{
  "name": "@zenui/preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types server.ts",
    "lint": "eslint src server.ts test vite.config.ts",
    "start": "node --experimental-strip-types server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80 --coverage.thresholds.statements=80",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zenui/html-compiler": "workspace:*",
    "@zenui/preview-bridge": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@zenui/design-schema": "workspace:*",
    "jsdom": "^26.1.0",
    "vite": "^7.2.7"
  }
}
