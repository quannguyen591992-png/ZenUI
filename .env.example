AI_GENERATE_MAX_OUTPUT_TOKENS=4096
AI_EDIT_MAX_OUTPUT_TOKENS=2048
AI_GENERATE_MAX_TOTAL_TOKENS=12000
AI_EDIT_MAX_TOTAL_TOKENS=8000
